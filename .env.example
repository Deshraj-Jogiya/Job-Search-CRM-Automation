# ============================================================
# Application
# ============================================================
SECRET_KEY=
# generate: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./crm.db

# ============================================================
# Dashboard / Admin protection
# ============================================================
DASHBOARD_PASSWORD=
# leave unset for pure-localhost personal use; set it if reachable beyond your own machine

ADMIN_PASSWORD=
# required for any future destructive actions (delete, reset) -- no insecure default

CREDENTIAL_ENCRYPTION_KEY=
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============================================================
# LLM provider selection
# ============================================================
# One of: anthropic | openai_compatible | ollama
LLM_PROVIDER=anthropic

# -- if LLM_PROVIDER=anthropic --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# -- if LLM_PROVIDER=openai_compatible (covers OpenAI, Gemini, etc.) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=
# leave OPENAI_API_BASE empty for real OpenAI; set to Gemini's OpenAI-compat
# endpoint (https://generativelanguage.googleapis.com/v1beta/openai/) to use
# Gemini's free tier instead

# -- if LLM_PROVIDER=ollama (fully local/free) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================================
# Living profile (Phase 1)
# ============================================================
PORTFOLIO_RESUME_URL=https://deshraj-jogiya.github.io/resume.json
# The portfolio site doesn't serve this endpoint yet (as of this phase's
# build) -- "Sync from Portfolio" will fail gracefully with a clear error
# until it's added there. Use the manual JSON paste or LinkedIn import
# flows on the Profile page in the meantime.

# ============================================================
# Job intake (Phase 2)
# ============================================================
# Adzuna is optional -- without these, the Adzuna source is skipped
# with a clear log entry and LinkedIn intake still runs on its own.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_MONTHLY_CALL_BUDGET=900
# Free tier is ~1,000 calls/month; kept a safety margin under that.

# ============================================================
# Confirmation-queue notifications (Phase 4) + outreach (Phase 5)
# ============================================================
# Same SMTP config powers both: Phase 4's one-click approve/reject
# emails, and Phase 5's outreach sends once that's wired in. Optional --
# without these, confirmation emails are skipped with a clear log entry
# and you fall back to reviewing the /jobs list and confirmation
# deadlines directly.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

APP_BASE_URL=http://localhost:8000
# Used to build the one-click links in confirmation emails. Update this
# if you deploy somewhere other than localhost.

# ============================================================
# IMAP status monitoring (optional until wired in)
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
