# ============================================================
# Application
# ============================================================
SECRET_KEY=
# generate: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./crm.db
# For a hosted Postgres DB (e.g. Supabase), use the connection string from
# Project Settings -> Database -> Connection string (NOT the project URL +
# publishable/anon key shown in Supabase's client-SDK "Connect" snippet --
# that pair is for their JS REST client, not a direct Postgres connection):
#   postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Requires the psycopg2-binary package (already in requirements.txt).

# ============================================================
# Dashboard / Admin protection
# ============================================================
DASHBOARD_PASSWORD=
# leave unset for pure-localhost personal use; set it if reachable beyond your own machine

ADMIN_PASSWORD=
# required for destructive actions (currently: backup restore); no insecure default

CREDENTIAL_ENCRYPTION_KEY=
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============================================================
# LLM provider selection
# ============================================================
# One of: anthropic | openai_compatible | ollama
LLM_PROVIDER=anthropic

# -- if LLM_PROVIDER=anthropic --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# -- if LLM_PROVIDER=openai_compatible (covers OpenAI, Gemini, etc.) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=
# leave OPENAI_API_BASE empty for real OpenAI; set to Gemini's OpenAI-compat
# endpoint (https://generativelanguage.googleapis.com/v1beta/openai/) to use
# Gemini's free tier instead

# -- if LLM_PROVIDER=ollama (fully local/free) --
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================================
# Living profile
# ============================================================
PORTFOLIO_RESUME_URL=
# Optional: a resume.json endpoint on your own site/portfolio, used by
# the "Sync from Portfolio" button on the Profile page. Leave empty to
# skip it and use the manual JSON paste or LinkedIn import flows instead.

# ============================================================
# Job intake
# ============================================================
# Adzuna is optional -- without these, the Adzuna source is skipped
# with a clear log entry and LinkedIn intake still runs on its own.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
ADZUNA_MONTHLY_CALL_BUDGET=900
# Free tier is ~1,000 calls/month; kept a safety margin under that.

# JobsPipe is also optional -- a normalizing aggregator that reaches
# ATS platforms (Workday, iCIMS, SmartRecruiters, Taleo, SuccessFactors)
# with no guessable per-company slug, unlike Greenhouse/Lever/Ashby/
# Recruitee/Personio. Sign up at https://jobspipe.dev for a key; without
# one this source is skipped with a clear log entry.
JOBSPIPE_API_KEY=
JOBSPIPE_MONTHLY_JOB_BUDGET=900
# Free tier is 1,000 jobs/month, billed per job returned (not per call);
# kept the same safety margin as Adzuna's budget above.

# ============================================================
# Confirmation-queue notifications + outreach
# ============================================================
# Same SMTP config powers both: the confirmation queue's one-click
# approve/reject emails, and outreach sends. Optional -- without these,
# confirmation emails are skipped with a clear log entry and you fall
# back to reviewing the /jobs list and confirmation deadlines directly.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

APP_BASE_URL=http://localhost:8000
# Used to build the one-click links in confirmation emails. Update this
# if you deploy somewhere other than localhost.

# ============================================================
# Recruiter contact discovery -- both optional
# ============================================================
# Without these, the "Discover Contact" button doesn't appear and
# outreach falls back to manual entry. Neither is required for the
# rest of outreach (drafting/approving/sending) to work.
TAVILY_API_KEY=
# Free tier: 1,000 queries/month, no credit card. Sign up at tavily.com.
# Finds LinkedIn profiles of likely recruiter/hiring contacts, and the
# company's domain (needed for Hunter below).

HUNTER_API_KEY=
# Free tier: 25 searches/50 credits per month, no credit card. Sign up
# at hunter.io. Only used if TAVILY_API_KEY is also set (needs the
# domain Tavily finds). Returns real found/verified emails at that
# domain with confidence scores -- never a guessed pattern.

# ============================================================
# IMAP status monitoring (optional until wired in)
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
