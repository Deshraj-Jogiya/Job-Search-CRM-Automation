[Unit]
Description=VNC server sharing the virtual display
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=career-pilot
Environment=DISPLAY=:99
# -localhost: only reachable via the websockify proxy below (never
# exposed directly to the internet), which is itself only reachable
# through Caddy's TLS + Basic Auth.
ExecStart=/usr/bin/x11vnc -display :99 -forever -shared -rfbauth /etc/x11vnc/vncpasswd.txt -localhost -rfbport 5900 -noxdamage
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
