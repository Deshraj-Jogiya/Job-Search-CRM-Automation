# Caddy auto-provisions and renews a real Let's Encrypt TLS cert with zero
# extra steps. Two ways to get a real, publicly-resolvable hostname for it:
#
# 1. Own a domain: point its DNS A record at the VM's public IP, then use
#    that domain below.
# 2. No domain yet: sslip.io resolves <ip-with-dashes>.sslip.io to that IP
#    automatically, e.g. 129-146-36-193.sslip.io for 129.146.36.193 -- a
#    real, public hostname with zero DNS setup, which Caddy can get a real
#    cert for just as well. Swap in a real domain later by just changing
#    the site address below and pointing its DNS at the VM.

your-domain-or-sslip-io-address {
    # Interactive autofill needs a real, visible browser (see
    # autofill_service.py's docstring -- deliberate, not headless by
    # accident) -- on a VM with no real display, that browser opens on a
    # virtual one instead (Xvfb + openbox), viewable through noVNC. This
    # route gets its own Basic Auth layer on top of the VNC password
    # itself, since the screen it shows can contain real personal/
    # application data. See deploy/README.md section 6 for the full
    # Xvfb/openbox/x11vnc/novnc setup this route proxies to.
    handle_path /vnc/* {
        basicauth {
            <username> <bcrypt-hash-from-caddy-hash-password>
        }
        reverse_proxy 127.0.0.1:6080
    }
    reverse_proxy 127.0.0.1:8000
}

# Install Caddy (Oracle Linux 9, via the project's own official COPR repo):
#   sudo dnf install -y "dnf-command(copr)"
#   sudo dnf copr enable -y @caddy/caddy
#   sudo dnf install -y caddy
#   sudo cp Caddyfile.example /etc/caddy/Caddyfile   # after filling in the real address/hash above
#   sudo restorecon -Rv /etc/caddy                   # SELinux -- see deploy/README.md section 2
#   sudo systemctl enable --now caddy
#
# Generate the basicauth hash: caddy hash-password --plaintext '<a-real-password>'
