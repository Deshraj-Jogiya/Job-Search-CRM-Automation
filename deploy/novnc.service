[Unit]
Description=noVNC web client (websockify) for the virtual display
After=x11vnc.service
Requires=x11vnc.service

[Service]
Type=simple
User=career-pilot
# Listens on localhost only -- Caddy reverse-proxies /vnc/ to this port
# and is the only thing that terminates real internet traffic, adding
# TLS + Basic Auth in front of what is otherwise a raw view of whatever
# real personal/application data happens to be on screen.
ExecStart=/opt/career-pilot/venv/bin/websockify --web /opt/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
