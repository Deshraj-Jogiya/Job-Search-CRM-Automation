# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local virtual environment
venv/
.venv/
env/

# Database files
*.db
*.sqlite

# Retained application logs (Phase 18 -- rotated locally, not committed)
logs/

# Restore staging + pre-restore safety-net backups (Phase 9 restore) --
# real encrypted snapshots of the live database, never committed
backups/

# Environment configuration
.env

# Author's private working notes (used with Claude Code during
# development) -- includes real job-search activity specific to the
# author's own deployment. See CONTRIBUTING.md for the public-facing
# replacement covering design principles and conventions.
CLAUDE.md

# Local Claude Code tooling config (preview launch config, scheduler
# lock file) -- machine-specific, not part of the application
.claude/

# Raw USCIS/DOL government data files for app/ingest/ -- large (tens of
# MB), publicly downloadable, not something to version. See SETUP.md.
data/raw/

# b1.3's learned column-header mapping state (app/ingest/column_utils.py)
# -- written by the app itself as fuzzy guesses/corrections happen,
# meaningful only against whatever real government data files THIS
# deployment has actually loaded, not portable config to share.
data/column_mappings.yaml
